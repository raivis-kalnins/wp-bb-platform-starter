cd ~/platform

cat > .gitignore <<'EOF'
.env
.env.*
!.env.example

auth.json
*.pem
*.key
*.crt

/vendor/
composer.phar

/web/wp/

/web/app/plugins/
/web/app/mu-plugins/
/web/app/themes/

/web/app/uploads/
/web/app/upgrade/
/web/app/cache/
/web/app/backups/
/web/app/backup-db/
/web/app/ai1wm-backups/
/web/app/wflogs/
/web/app/litespeed/

/storage/logs/*
/storage/framework/cache/*
/storage/framework/sessions/*
/storage/framework/views/*

**/node_modules/

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

/releases/
*.tar.gz

.phpunit.result.cache
.php-cs-fixer.cache
.phpstan.cache

.idea/
.vscode/
*.code-workspace

*.swp
*.swo
*~

.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
Desktop.ini

*.log
*.tmp
*.temp
*.bak

/tmp/
/temp/

docker-compose.override.yml
EOF