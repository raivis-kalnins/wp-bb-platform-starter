#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
STAMP=$(date +%Y%m%d-%H%M%S)
NAME="wp-bb-platform-release-$STAMP"
DEST="releases/$NAME"
rm -rf "$DEST"
mkdir -p "$DEST"

# Make sure dependencies are installed and optimized before copying.
bin/composer install --no-dev --prefer-dist --optimize-autoloader --no-interaction

# Build parent theme assets when the node profile is available. Existing packaged assets remain if build is skipped.
if [ -f packages/wp-bbtheme/package.json ]; then
  docker compose run --rm node npm install || true
  docker compose run --rm node npm run prod || true
fi

rsync -a ./ "$DEST/" \
  --exclude '.git' \
  --exclude '.env' \
  --exclude '.env.local' \
  --exclude 'releases' \
  --exclude 'node_modules' \
  --exclude 'docker-compose.yml' \
  --exclude 'docker'

cp .env.example "$DEST/.env.example"
(
  cd releases
  zip -qr "$NAME.zip" "$NAME"
)
echo "Created releases/$NAME.zip"
