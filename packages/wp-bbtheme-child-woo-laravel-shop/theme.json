{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "1180px",
      "wideSize": "1440px"
    },
    "color": {
      "palette": [
        {
          "slug": "brand",
          "color": "#2f8b49",
          "name": "WP BB HOME & GARDEN Green"
        },
        {
          "slug": "navy",
          "color": "#163047",
          "name": "WP BB HOME & GARDEN Navy"
        },
        {
          "slug": "accent",
          "color": "#e8b63e",
          "name": "Warm Accent"
        },
        {
          "slug": "muted",
          "color": "#6c7884",
          "name": "Muted"
        },
        {
          "slug": "surface",
          "color": "#f5f7f5",
          "name": "Surface"
        },
        {
          "slug": "white",
          "color": "#ffffff",
          "name": "White"
        }
      ]
    },
    "typography": {
      "fontFamilies": [
        {
          "fontFamily": "Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
          "slug": "inter",
          "name": "Inter/System"
        }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "#f5f7f5",
      "text": "#1b2a38"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--inter)",
      "fontSize": "16px",
      "lineHeight": "1.55"
    },
    "elements": {
      "link": {
        "color": {
          "text": "#163047"
        },
        ":hover": {
          "color": {
            "text": "#2f8b49"
          }
        }
      }
    }
  },
  "templateParts": [
    {
      "name": "header",
      "title": "Header",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer",
      "area": "footer"
    }
  ]
}