DB_NAME='wpbb'
DB_USER='wpbb'
DB_PASSWORD='change-me'
DB_ROOT_PASSWORD='root-change-me'
DB_HOST='db'
DB_PREFIX='wp_'

WP_ENV='development'
WP_ENVIRONMENT_TYPE='development'

WP_HOME='http://localhost:8080'
WP_SITEURL='http://localhost:8080/wp'

# Used only with docker-compose.proxy.yml.
SITE_DOMAIN='wpbb.localhost'
PMA_DOMAIN='db.wpbb.localhost'
# Uncomment after starting docker/rproxy/up.sh to make all helpers use the proxy.
# COMPOSE_FILE='docker-compose.yml:docker-compose.proxy.yml'

REDIS_HOST='redis'
REDIS_PORT='6379'

WP_DEBUG_LOG='true'
WPBB_ALLOW_ADMIN_CLI='false'

AUTH_KEY='generateme'
SECURE_AUTH_KEY='generateme'
LOGGED_IN_KEY='generateme'
NONCE_KEY='generateme'
AUTH_SALT='generateme'
SECURE_AUTH_SALT='generateme'
LOGGED_IN_SALT='generateme'
NONCE_SALT='generateme'
